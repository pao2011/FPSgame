{
  "name": "isla-royale",
  "private": true,
  "version": "0.4.0",
  "description": "Battle royale 3D estilo Fortnite en el navegador (Three.js), con modo online",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --open",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "build:standalone": "vite build && node scripts/standalone.mjs",
    "preview": "vite preview --open"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
